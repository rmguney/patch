#version 450

/*
 * raymarch_ao.comp - short-range ambient occlusion: cosine-weighted hemisphere rays through
 * the terrain shadow volume (shadow_volume.glsl), accumulated over frames by temporal_ao.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "include/voxel_push_constants.glsl"
#include "include/gbuffer_sample.glsl"

/* Terrain shadow volume (set 0, binding 0), see shadow_volume.glsl */
layout(set = 0, binding = 0) uniform usampler3D shadow_volume_tex;

#include "include/hdda_core.glsl"
#include "include/shadow_volume.glsl"

layout(set = 1, binding = 0) uniform sampler2D gbuffer_depth;
layout(set = 1, binding = 1) uniform sampler2D gbuffer_normal;
layout(set = 1, binding = 2) uniform sampler2D blue_noise_tex;

layout(r8, set = 2, binding = 0) writeonly uniform image2D out_ao;

const int BASE_AO_STEPS = 64;
const float AO_RADIUS_VOXELS = 3.0; /* occlusion search radius, in voxels */

vec3 world_to_grid(vec3 world_pos) {
    return (world_pos - pc.bounds_min) / pc.voxel_size;
}

/* Ray distance at which a DDA that hdda_skip_block just moved past a block left it: the last
 * boundary crossed on an exit axis (the selects keep other axes' infinities out of the math) */
float block_exit_distance(vec3 side_dist, vec3 delta_dist, bvec3 exit_mask) {
    vec3 crossed = mix(vec3(1e30), side_dist - delta_dist, exit_mask);
    return min(min(crossed.x, crossed.y), crossed.z);
}

/* Visibility (0..1) of one AO ray: distance to where it enters the first occupied voxel / radius */
float trace_ao_ray(vec3 origin, vec3 rd, int max_steps) {
    vec2 box_hit = hdda_intersect_aabb(origin, rd, pc.bounds_min, pc.bounds_max);
    if (box_hit.x > box_hit.y || box_hit.y < 0.0) {
        return 1.0;
    }

    float t_start = max(box_hit.x, 0.001);
    vec3 start_pos = origin + rd * t_start;
    vec3 grid_pos = world_to_grid(start_pos);
    grid_pos = clamp(grid_pos, vec3(0.0), vec3(pc.grid_size) - 0.001);

    ivec3 map_pos = ivec3(floor(grid_pos));
    vec3 delta_dist = abs(1.0 / rd);
    ivec3 step_dir = ivec3(sign(rd));
    vec3 side_dist = (sign(rd) * (vec3(map_pos) - grid_pos) + sign(rd) * 0.5 + 0.5) * delta_dist;

    /* Distance from the start point to where the ray entered the current cell, in voxels
       (side_dist is in grid units), tracked through the DDA instead of a length() per step:
       an occluder the ray starts against reads ~0 visibility */
    float t_entry = 0.0;

    for (int i = 0; i < max_steps; i++) {
        if (map_pos.x < 0 || map_pos.x >= pc.grid_size.x ||
            map_pos.y < 0 || map_pos.y >= pc.grid_size.y ||
            map_pos.z < 0 || map_pos.z >= pc.grid_size.z) {
            return 1.0;
        }

        if (t_entry > AO_RADIUS_VOXELS) {
            return 1.0;
        }

        /* Jump the coarsest empty block around map_pos, staying on the ray */
        uint occ0;
        int level = shadow_volume_empty_level(map_pos, occ0);
        if (level >= 0) {
            ivec3 block_min = (map_pos >> (level + 1)) << (level + 1);
            bvec3 exit_mask;
            int skip = hdda_skip_block(map_pos, side_dist, step_dir, delta_dist, block_min, block_min + ((2 << level) - 1), exit_mask);
            t_entry = block_exit_distance(side_dist, delta_dist, exit_mask);
            i += max(skip - 1, 0);
            continue;
        }

        if (shadow_volume_opaque(occ0, map_pos)) {
            return t_entry / AO_RADIUS_VOXELS;
        }

        /* The next cell is entered where this one is left */
        t_entry = min(min(side_dist.x, side_dist.y), side_dist.z);
        bvec3 mask = lessThanEqual(side_dist.xyz, min(side_dist.yzx, side_dist.zxy));
        side_dist += vec3(mask) * delta_dist;
        map_pos += ivec3(mask) * step_dir;
    }

    return 1.0;
}

vec3 cosine_weighted_hemisphere(vec2 xi, vec3 N) {
    float phi = 2.0 * 3.14159265 * xi.y;
    float cos_theta = sqrt(1.0 - xi.x);
    float sin_theta = sqrt(xi.x);

    vec3 local_dir = vec3(
        cos(phi) * sin_theta,
        sin(phi) * sin_theta,
        cos_theta
    );

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return tangent * local_dir.x + bitangent * local_dir.y + N * local_dir.z;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen_size = imageSize(out_ao);

    if (pixel.x >= screen_size.x || pixel.y >= screen_size.y) {
        return;
    }

    GBufferSample g = sample_gbuffer_shadow(pixel, gbuffer_depth, gbuffer_normal);

    if (g.is_sky) {
        imageStore(out_ao, pixel, vec4(1.0));
        return;
    }

    vec3 normal = normalize(g.normal);

    /* Distance-based AO step scaling: close surfaces need fewer steps */
    float surface_dist = length(g.world_pos - pc.camera_pos);
    int ao_steps = BASE_AO_STEPS;
    if (surface_dist < 15.0) {
        ao_steps = 32;   /* Close: half steps */
    } else if (surface_dist < 40.0) {
        ao_steps = 48;   /* Mid: 75% steps */
    }

    vec2 noise_uv = vec2(pixel) / 128.0;
    float spatial_noise = texture(blue_noise_tex, noise_uv).r;
    float temporal_offset = float(pc.frame_count) * 0.6180339887;

    float bias = pc.voxel_size * 0.4;
    vec3 ao_origin = g.world_pos + normal * bias;

    /* Quality-scaled samples: Fair=1, Good=2, High=4 samples per pixel.
       Temporal accumulation smooths out noise over frames, so close surfaces
       (where it works best) use one sample less. */
    int base_samples = (pc.ao_quality <= 1) ? 1 : (pc.ao_quality == 2 ? 2 : 4);
    int num_samples = base_samples;
    if (surface_dist < 10.0 && base_samples > 1) {
        num_samples = base_samples - 1;
    }
    float ao_sum = 0.0;

    for (int s = 0; s < num_samples; s++) {
        float noise = fract(spatial_noise + temporal_offset + float(s) * 0.5);
        float noise2 = fract(spatial_noise * 1.618 + temporal_offset + float(s) * 0.309);

        vec2 xi = vec2(noise, noise2);

        vec3 ao_dir = cosine_weighted_hemisphere(xi, normal);

        ao_sum += trace_ao_ray(ao_origin, ao_dir, ao_steps);
    }

    float ao = ao_sum / float(num_samples);

    imageStore(out_ao, pixel, vec4(ao, 0.0, 0.0, 0.0));
}
