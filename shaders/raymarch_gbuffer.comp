#version 450

/*
 * raymarch_gbuffer.comp - primary rays through the terrain volume (hierarchical DDA over
 * chunk / region occupancy) into the G-buffer. Voxel objects and particles are rasterized
 * on top of it afterwards (voxel_object.*, particle.*).
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "include/voxel_push_constants.glsl"

/* Global parameters required by data_terrain.glsl */
ivec3 pc_grid_size;
ivec3 pc_chunks_dim;
int pc_total_chunks;

/* Terrain data bindings (set 0) */
layout(std430, set = 0, binding = 0) readonly buffer VoxelBuffer {
    uint voxel_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer ChunkHeaders {
    uvec4 chunk_headers[];
};

layout(std140, set = 0, binding = 2) uniform MaterialPalette {
    vec4 materials[512];
};

#include "include/materials.glsl"
#include "include/gbuffer_sample.glsl"
#include "include/data_terrain.glsl"
#include "include/hdda_core.glsl"

layout(std140, set = 0, binding = 3) uniform TemporalUBO {
    mat4 prev_view_proj;
    vec4 prev_camera_pos;
    vec2 jitter_uv;
    vec2 inv_render_size;
};

/* Terrain shadow volume, the opaque voxels (shadow_volume.glsl): below a water surface it finds the
 * first opaque voxel without visiting the water voxel by voxel */
layout(set = 0, binding = 4) uniform usampler3D shadow_volume_tex;

#include "include/shadow_volume.glsl"

/* G-buffer outputs (set 1) - see gbuffer_sample.glsl for the layout and downstream sampling */
layout(rgba8, set = 1, binding = 0) writeonly uniform image2D out_albedo;
layout(rgb10_a2, set = 1, binding = 1) writeonly uniform image2D out_normal;
layout(rg32ui, set = 1, binding = 2) writeonly uniform uimage2D out_material;
layout(r32f, set = 1, binding = 3) writeonly uniform image2D out_depth;
layout(rg16f, set = 1, binding = 4) writeonly uniform image2D out_motion_vector;

vec3 world_to_grid(vec3 world_pos) {
    return (world_pos - pc.bounds_min) / pc.voxel_size;
}

/* The opaque voxel at map_pos, entered across the faces of last_mask */
HitInfo solid_hit(vec3 ro, vec3 rd, ivec3 map_pos, uint mat, bvec3 last_mask, float water_entry_t) {
    vec3 voxel_min = pc.bounds_min + vec3(map_pos) * pc.voxel_size;
    HitInfo info;
    info.hit = true;
    info.color = get_material_color(mat);
    info.emissive = get_material_emissive(mat);
    info.roughness = get_material_roughness(mat);
    info.metallic = get_material_metallic(mat);
    info.t = hdda_intersect_aabb(ro, rd, voxel_min, voxel_min + pc.voxel_size).x;
    info.pos = ro + rd * info.t;
    info.water_depth = water_entry_t >= 0.0 ? info.t - water_entry_t : 0.0;
    info.normal = hdda_compute_normal(last_mask, rd);
    return info;
}

/* water_material: the material of the transparent voxel the ray entered water at (0: none) */
HitInfo raymarch_terrain(vec3 ro, vec3 rd, out uint water_material) {
    water_material = 0u;
    HitInfo info;
    info.hit = false;
    info.t = 1e10;
    info.water_depth = 0.0;

    float water_entry_t = -1.0;

    vec2 box_hit = hdda_intersect_aabb(ro, rd, pc.bounds_min, pc.bounds_max);
    if (box_hit.x > box_hit.y || box_hit.y < 0.0) {
        return info;
    }

    float t_start = max(box_hit.x, 0.001);
    vec3 start_pos = ro + rd * t_start;
    vec3 grid_pos = world_to_grid(start_pos);
    grid_pos = clamp(grid_pos, vec3(0.0), vec3(pc.grid_size) - 0.001);

    ivec3 map_pos = ivec3(floor(grid_pos));
    vec3 delta_dist = abs(1.0 / rd);
    ivec3 step_dir = ivec3(sign(rd));
    vec3 side_dist = (sign(rd) * (vec3(map_pos) - grid_pos) + sign(rd) * 0.5 + 0.5) * delta_dist;

    ivec3 last_chunk = ivec3(-1000);
    ivec3 last_region = ivec3(-1000);
    bool chunk_empty = false;
    bool region_empty = false;
    int current_chunk_idx = -1;

    /* Compute initial entry face */
    bvec3 last_mask;
    if (box_hit.x > 0.0) {
        vec3 inv_rd = 1.0 / rd;
        vec3 t0 = (pc.bounds_min - ro) * inv_rd;
        vec3 t1 = (pc.bounds_max - ro) * inv_rd;
        vec3 tmin = min(t0, t1);
        float max_tmin = max(max(tmin.x, tmin.y), tmin.z);
        last_mask = bvec3(
            abs(tmin.x - max_tmin) < 0.0001,
            abs(tmin.y - max_tmin) < 0.0001,
            abs(tmin.z - max_tmin) < 0.0001
        );
    } else {
        vec3 frac_pos = fract(grid_pos);
        vec3 dist_to_face = mix(frac_pos, 1.0 - frac_pos, greaterThan(rd, vec3(0.0)));
        float min_dist = min(min(dist_to_face.x, dist_to_face.y), dist_to_face.z);
        last_mask = lessThanEqual(dist_to_face, vec3(min_dist + 0.0001));
    }

    /* Empty chunks and regions are jumped in one iteration each */
    int i = 0;
    for (; i < pc.max_steps; i++) {
        if (map_pos.x < 0 || map_pos.x >= pc.grid_size.x ||
            map_pos.y < 0 || map_pos.y >= pc.grid_size.y ||
            map_pos.z < 0 || map_pos.z >= pc.grid_size.z) {
            break;
        }

        /* Level 2: Chunk occupancy */
        ivec3 current_chunk = map_pos / CHUNK_SIZE;
        if (current_chunk != last_chunk) {
            last_chunk = current_chunk;
            current_chunk_idx = current_chunk.x + current_chunk.y * pc.chunks_dim.x +
                               current_chunk.z * pc.chunks_dim.x * pc.chunks_dim.y;
            chunk_empty = !sample_occupancy_chunk(current_chunk_idx);
            last_region = ivec3(-1000);
        }

        if (chunk_empty) {
            ivec3 chunk_min = current_chunk * CHUNK_SIZE;
            hdda_skip_block(map_pos, side_dist, step_dir, delta_dist, chunk_min, chunk_min + (CHUNK_SIZE - 1), last_mask);
            continue;
        }

        /* Level 1: Region occupancy (8x8x8) */
        ivec3 local_pos = map_pos - current_chunk * CHUNK_SIZE;
        ivec3 current_region = local_pos / REGION_SIZE;
        if (current_region != last_region) {
            last_region = current_region;
            region_empty = !sample_occupancy_region(current_chunk_idx, current_region);
        }

        if (region_empty) {
            ivec3 region_min = current_chunk * CHUNK_SIZE + current_region * REGION_SIZE;
            hdda_skip_block(map_pos, side_dist, step_dir, delta_dist, region_min, region_min + (REGION_SIZE - 1), last_mask);
            continue;
        }

        /* Level 0: Per-voxel check */
        uint mat = sample_material(map_pos);
        if (mat != 0u) {
            if (!is_material_transparent(mat)) {
                return solid_hit(ro, rd, map_pos, mat, last_mask, -1.0);
            }
            /* Transparent voxel: the water starts here, and its material colours it */
            vec3 voxel_min = pc.bounds_min + vec3(map_pos) * pc.voxel_size;
            water_entry_t = hdda_intersect_aabb(ro, rd, voxel_min, voxel_min + pc.voxel_size).x;
            water_material = mat;
            break;
        }

        bvec3 mask = lessThanEqual(side_dist.xyz, min(side_dist.yzx, side_dist.zxy));
        last_mask = mask;
        side_dist += vec3(mask) * delta_dist;
        map_pos += ivec3(mask) * step_dir;
    }

    if (water_entry_t < 0.0) {
        return info;
    }

    /* Past the water surface only an opaque voxel ends the ray, and the shadow volume holds
     * exactly those: its empty blocks are jumped, water or air. The search starts in the voxel
     * after the one the water begins in. */
    bvec3 mask = lessThanEqual(side_dist.xyz, min(side_dist.yzx, side_dist.zxy));
    last_mask = mask;
    side_dist += vec3(mask) * delta_dist;
    map_pos += ivec3(mask) * step_dir;
    for (i++; i < pc.max_steps; i++) {
        if (map_pos.x < 0 || map_pos.x >= pc.grid_size.x ||
            map_pos.y < 0 || map_pos.y >= pc.grid_size.y ||
            map_pos.z < 0 || map_pos.z >= pc.grid_size.z) {
            break;
        }

        uint occ0;
        int level = shadow_volume_empty_level(map_pos, occ0);
        if (level >= 0) {
            ivec3 block_min = (map_pos >> (level + 1)) << (level + 1);
            hdda_skip_block(map_pos, side_dist, step_dir, delta_dist, block_min, block_min + ((2 << level) - 1), last_mask);
            continue;
        }

        if (shadow_volume_opaque(occ0, map_pos)) {
            /* The material decides: a large edit reaches the shadow volume in one frame, the
             * chunk data over a few */
            uint mat = sample_material(map_pos);
            if (mat != 0u && !is_material_transparent(mat)) {
                return solid_hit(ro, rd, map_pos, mat, last_mask, water_entry_t);
            }
        }

        mask = lessThanEqual(side_dist.xyz, min(side_dist.yzx, side_dist.zxy));
        last_mask = mask;
        side_dist += vec3(mask) * delta_dist;
        map_pos += ivec3(mask) * step_dir;
    }

    /* Water with nothing opaque behind it: the water surface, in the water's own colour */
    info.hit = true;
    info.t = water_entry_t;
    info.pos = ro + rd * water_entry_t;
    info.normal = vec3(0.0, 1.0, 0.0);
    info.color = get_material_color(water_material);
    info.emissive = get_material_emissive(water_material);
    info.roughness = get_material_roughness(water_material);
    info.metallic = get_material_metallic(water_material);
    info.water_depth = box_hit.y - water_entry_t;
    return info;
}

void main() {
    /* Initialize globals for data_terrain.glsl */
    pc_grid_size = pc.grid_size;
    pc_chunks_dim = pc.chunks_dim;
    pc_total_chunks = pc.total_chunks;

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen_size = imageSize(out_albedo);

    if (pixel.x >= screen_size.x || pixel.y >= screen_size.y) {
        return;
    }

    vec3 ray_origin, ray_dir;
    camera_generate_ray(pixel, screen_size, pc.inv_view, pc.inv_projection, pc.camera_pos,
                        ray_origin, ray_dir);

    uint water_material;
    HitInfo best_hit = raymarch_terrain(ray_origin, ray_dir, water_material);

    /* Write to G-buffer */
    if (best_hit.hit) {
        imageStore(out_albedo, pixel, vec4(best_hit.color, 1.0));
        imageStore(out_normal, pixel, vec4(best_hit.normal * 0.5 + 0.5, 1.0));
        imageStore(out_material, pixel, uvec4(gbuffer_pack_material(best_hit.roughness, best_hit.metallic, best_hit.emissive,
                                                                    water_material, best_hit.water_depth), 0u, 0u));
        imageStore(out_depth, pixel, vec4(best_hit.t, 0.0, 0.0, 0.0));

        /* Motion vectors for temporal effects */
        vec2 curr_uv = (vec2(pixel) + 0.5) * inv_render_size - jitter_uv;
        vec2 motion = camera_motion_vector(curr_uv, prev_view_proj * vec4(best_hit.pos, 1.0));
        imageStore(out_motion_vector, pixel, vec4(motion, 0.0, 0.0));
    } else {
        /* Sky/miss - write transparent alpha so lighting shader knows */
        imageStore(out_albedo, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(out_normal, pixel, vec4(0.5, 0.5, 1.0, 0.0));
        imageStore(out_material, pixel, uvec4(gbuffer_pack_material(1.0, 0.0, 0.0, 0u, 0.0), 0u, 0u));
        imageStore(out_depth, pixel, vec4(1e10, 0.0, 0.0, 0.0));
        imageStore(out_motion_vector, pixel, vec4(0.0, 0.0, 0.0, 0.0));
    }
}
