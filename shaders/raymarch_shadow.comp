#version 450

/*
 * raymarch_shadow.comp - sun shadows for every G-buffer pixel: soft shadow rays through the
 * terrain shadow volume (occupancy mips up to a texel per chunk) and, via the object BVH, voxel
 * objects.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "include/voxel_push_constants.glsl"
#include "include/gbuffer_sample.glsl"

/* Terrain shadow volume (set 0, binding 0), see shadow_volume.glsl */
layout(set = 0, binding = 0) uniform usampler3D shadow_volume_tex;

/* Material palette (set 0, binding 1) - voxel object colors (materials.glsl) */
layout(std140, set = 0, binding = 1) uniform MaterialPalette {
    vec4 materials[512];
};

#include "include/materials.glsl"
#include "include/hdda_core.glsl"
#include "include/shadow_volume.glsl"

/* Voxel object data bindings (set 3) - direct object tracing for accurate rotated shadows */
#include "include/voxobj_types.glsl"

layout(set = 3, binding = 0) uniform usampler3D vobj_atlas;

layout(std430, set = 3, binding = 1) readonly buffer ObjectMetadata {
    VoxelObjectGPU objects[];
};

#define BVH_SET 3
#define BVH_BINDING 2
#include "include/bvh.glsl"

#include "include/data_voxobj.glsl"
#include "include/bvh_traverse.glsl"

#define LIGHTING_SET 4
#include "include/scene_lighting.glsl"

/* G-buffer inputs (set 1) */
layout(set = 1, binding = 0) uniform sampler2D gbuffer_depth;
layout(set = 1, binding = 1) uniform sampler2D gbuffer_normal;
layout(set = 1, binding = 2) uniform sampler2D blue_noise_tex;

/* Shadow output (set 2) */
layout(r8, set = 2, binding = 0) writeonly uniform image2D out_shadow;

/* Constants (CHUNK_SIZE, REGION_SIZE, CHUNK_UINT_COUNT from hdda_types.glsl) */
const int BASE_SHADOW_STEPS = 128;  /* Base step count for far surfaces */
#define SHADOW_MAX_DIST (lighting.sky_color_params.w)
const float SHADOW_DIST_VERY_FAR = 100.0;
const float SHADOW_DIST_FAR = 60.0;
const int SHADOW_STEPS_VERY_FAR = 64;
const int SHADOW_STEPS_FAR = 96;

#define SUN_DIR (lighting.sun_dir.xyz)

vec3 world_to_grid(vec3 world_pos) {
    return (world_pos - pc.bounds_min) / pc.voxel_size;
}

/* Trace shadow ray through terrain volume, returns hit distance (max_dist if no hit) */
float trace_terrain_shadow_hdda(vec3 origin, vec3 rd, float max_dist, int max_steps) {
    vec2 box_hit = hdda_intersect_aabb(origin, rd, pc.bounds_min, pc.bounds_max);
    if (box_hit.x > box_hit.y || box_hit.y < 0.0) {
        return max_dist;
    }

    float t_start = max(box_hit.x, 0.001);
    float t_end = min(box_hit.y, max_dist);

    if (t_start >= t_end) {
        return max_dist;
    }

    vec3 start_pos = origin + rd * t_start;
    vec3 grid_pos = world_to_grid(start_pos);
    grid_pos = clamp(grid_pos, vec3(0.0), vec3(pc.grid_size) - 0.001);

    ivec3 map_pos = ivec3(floor(grid_pos));
    vec3 delta_dist = abs(1.0 / rd);
    ivec3 step_dir = ivec3(sign(rd));
    vec3 side_dist = (sign(rd) * (vec3(map_pos) - grid_pos) + sign(rd) * 0.5 + 0.5) * delta_dist;

    /* i counts the voxel cells crossed, jumps included: the reach is the same whichever blocks
     * the empty space is crossed in */
    for (int i = 0; i < max_steps; i++) {
        if (map_pos.x < 0 || map_pos.x >= pc.grid_size.x ||
            map_pos.y < 0 || map_pos.y >= pc.grid_size.y ||
            map_pos.z < 0 || map_pos.z >= pc.grid_size.z) {
            return max_dist;
        }

        /* Jump the coarsest empty block around map_pos: a chunk in the open air above the
         * terrain, down to 2x2x2 voxels next to it */
        uint occ0;
        int level = shadow_volume_empty_level(map_pos, occ0);
        if (level >= 0) {
            ivec3 block_min = (map_pos >> (level + 1)) << (level + 1);
            bvec3 exit_mask;
            int skip = hdda_skip_block(map_pos, side_dist, step_dir, delta_dist, block_min, block_min + ((2 << level) - 1), exit_mask);
            i += max(skip - 1, 0);
            continue;
        }

        if (shadow_volume_opaque(occ0, map_pos)) {
            /* Compute actual world distance to hit voxel center */
            vec3 hit_grid = vec3(map_pos) + 0.5;
            vec3 hit_world = pc.bounds_min + hit_grid * pc.voxel_size;
            return length(hit_world - origin);
        }

        bvec3 mask = lessThanEqual(side_dist.xyz, min(side_dist.yzx, side_dist.zxy));
        side_dist += vec3(mask) * delta_dist;
        map_pos += ivec3(mask) * step_dir;
    }

    return max_dist;
}

/* Trace shadow ray, returns hit distance (max_dist if no hit)
   Traces both terrain shadow volume and object voxels directly */
float trace_shadow_hdda_dist(vec3 origin, vec3 rd, float max_dist, int max_steps) {
    /* Trace terrain shadow volume (fast hierarchical skip) */
    float terrain_t = trace_terrain_shadow_hdda(origin, rd, max_dist, max_steps);

    /* Voxel objects through the BVH, traced voxel by voxel (rotated geometry) */
    return bvh_trace_object_shadow(origin, rd, terrain_t, pc.object_count);
}

/* 1 = lit, 0 = occluded */
float trace_shadow_hdda(vec3 origin, vec3 rd, float max_dist, int max_steps) {
    return trace_shadow_hdda_dist(origin, rd, max_dist, max_steps) < max_dist ? 0.0 : 1.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen_size = imageSize(out_shadow);

    if (pixel.x >= screen_size.x || pixel.y >= screen_size.y) {
        return;
    }

    GBufferSample g = sample_gbuffer_shadow(pixel, gbuffer_depth, gbuffer_normal);

    if (g.is_sky) {
        imageStore(out_shadow, pixel, vec4(1.0));
        return;
    }

    vec3 normal = normalize(g.normal);

    /* Distance-based step reduction for FAR surfaces only.
       Close surfaces keep full steps for shadow accuracy.
       Far surfaces can use fewer steps - artifacts less visible at distance. */
    float surface_dist = length(g.world_pos - pc.camera_pos);
    int shadow_steps;
    if (surface_dist > SHADOW_DIST_VERY_FAR) {
        shadow_steps = SHADOW_STEPS_VERY_FAR;   /* >100m: half steps */
    } else if (surface_dist > SHADOW_DIST_FAR) {
        shadow_steps = SHADOW_STEPS_FAR;   /* >60m: 75% steps */
    } else {
        shadow_steps = BASE_SHADOW_STEPS;
    }

    float effective_max_dist = SHADOW_MAX_DIST;

    vec3 tangent = normalize(cross(SUN_DIR, vec3(0.0, 1.0, 0.01)));
    vec3 bitangent = cross(SUN_DIR, tangent);

    /* Bias along light direction instead of normal - ensures shadow ray starts
       outside occluders regardless of surface orientation */
    float light_bias = pc.voxel_size * 1.0;
    /* Normal bias grows as the sun gets more grazing (1 / N.L, capped at 5x) */
    float angle_factor = max(0.2, dot(SUN_DIR, normal));
    float normal_bias = pc.voxel_size * 0.3 / angle_factor;
    vec3 shadow_origin = g.world_pos + SUN_DIR * light_bias + normal * normal_bias;

    /* Contact hardening only when enabled, otherwise use constant penumbra */
    float base_penumbra = 0.04 + 0.02 * float(pc.shadow_quality);
    float penumbra = base_penumbra;

    if (pc.shadow_contact != 0 && pc.shadow_quality >= 2) {
        /* Contact hardening: trace center ray to find occluder distance */
        float occluder_dist = trace_shadow_hdda_dist(shadow_origin, SUN_DIR, effective_max_dist, shadow_steps);

        /* Scale penumbra: near occluder = sharper, far = softer
           If center ray misses, use full penumbra (jittered rays may still hit) */
        if (occluder_dist < effective_max_dist) {
            float contact_factor = smoothstep(0.0, 8.0, occluder_dist) * 0.7 + 0.3;
            penumbra = base_penumbra * contact_factor;
        }
    }

    /*
     * One ray per pixel and frame toward a point of the sun's disk; temporal_shadow.comp
     * accumulates them into the penumbra. The point is the pixel's blue noise (two decorrelated
     * values of the interleaved gradient noise texture) rotated by this frame's element of the
     * R2 sequence: every pixel walks a low-discrepancy sequence over the frames while its
     * neighbours, which the resolve also blurs in, sit at other points of it.
     */
    const vec2 R2 = vec2(0.7548776662466927, 0.5698402909980532); /* 1 / plastic number, its square */
    vec2 noise = vec2(texture(blue_noise_tex, vec2(pixel) / 128.0).r,
                      texture(blue_noise_tex, (vec2(pixel) + vec2(64.0, 37.0)) / 128.0).r);
    vec2 u = fract(noise + R2 * float(pc.frame_count));
    float radius = sqrt(u.x) * penumbra; /* uniform over the disk */
    float angle = u.y * 6.28318531;
    vec3 jittered_light = normalize(SUN_DIR + (tangent * cos(angle) + bitangent * sin(angle)) * radius);

    float shadow = trace_shadow_hdda(shadow_origin, jittered_light, effective_max_dist, shadow_steps);
    /* Remap shadow: 0.05 minimum prevents pure black while maintaining contrast */
    shadow = mix(0.05, 1.0, shadow);

    imageStore(out_shadow, pixel, vec4(shadow, 0.0, 0.0, 0.0));
}
