#version 450

/*
 * temporal_ao.comp - temporal accumulation of ambient occlusion with reprojection. The history
 * keeps each pixel's linear depth beside its AO; history is rejected on disocclusion, where the
 * depth the reprojected history saw differs from the depth this surface point had from last
 * frame's camera.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "include/voxel_push_constants.glsl"
#include "include/camera.glsl"

layout(set = 0, binding = 0) uniform sampler2D gbuffer_linear_depth;
layout(set = 0, binding = 1) uniform sampler2D gbuffer_motion_vector;
layout(set = 0, binding = 2) uniform sampler2D ao_current;
layout(set = 0, binding = 3) uniform sampler2D ao_history; /* r: resolved AO, g: its linear depth */

layout(std140, set = 0, binding = 4) uniform TemporalUBO {
    mat4 prev_view_proj;
    vec4 prev_camera_pos;
    vec2 jitter_uv;
    vec2 inv_render_size;
};

layout(rg16f, set = 1, binding = 0) writeonly uniform image2D out_ao_resolved;

const float HISTORY_BLEND_MAX = 0.75;
const float HISTORY_BLEND_MIN = 0.45;
const float DEPTH_REJECT_THRESHOLD = 0.02;
const float HISTORY_DEPTH_MAX = 65504.0; /* largest half float: sky depth (1e10) is stored as this */

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_ao_resolved);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);

    float current_ao = texelFetch(ao_current, pixel, 0).r;
    float current_depth = texelFetch(gbuffer_linear_depth, pixel, 0).r;
    vec4 current = vec4(current_ao, min(current_depth, HISTORY_DEPTH_MAX), 0.0, 0.0);

    if (pc.history_valid == 0) {
        imageStore(out_ao_resolved, pixel, current);
        return;
    }

    vec2 motion = texture(gbuffer_motion_vector, uv).xy;
    vec2 prev_uv = uv + motion;

    if (any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0)))) {
        imageStore(out_ao_resolved, pixel, current);
        return;
    }

    /* This pixel's surface point, and its distance from last frame's camera: the depth the
     * history must have seen there if the point was visible then */
    vec3 ray_origin, ray_dir;
    camera_generate_ray(pixel, size, pc.inv_view, pc.inv_projection, pc.camera_pos, ray_origin, ray_dir);
    vec3 surface = ray_origin + ray_dir * current_depth;
    float expected_depth = length(surface - prev_camera_pos.xyz);

    vec2 history = texture(ao_history, prev_uv).rg;
    float depth_diff = abs(history.g - expected_depth) / max(expected_depth, 0.001);
    if (depth_diff > DEPTH_REJECT_THRESHOLD) {
        imageStore(out_ao_resolved, pixel, current);
        return;
    }

    float motion_len = length(motion * vec2(size));
    float velocity_weight = clamp(motion_len / 4.0, 0.0, 1.0);
    float history_blend = mix(HISTORY_BLEND_MAX, HISTORY_BLEND_MIN, velocity_weight);

    float resolved = mix(current_ao, history.r, history_blend);
    imageStore(out_ao_resolved, pixel, vec4(resolved, current.g, 0.0, 0.0));
}
